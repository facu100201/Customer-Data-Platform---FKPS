{
  "name": "cdp-fkps",
  "version": "0.1.0",
  "private": true,
  "description": "Customer Data Platform del equipo FKPS servido por Apache sobre ZeroTier",
  "type": "module",
  "workspaces": [
    "shared",
    "db",
    "backend/*",
    "frontend/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "npm run dev -w @cdp/api",
    "dev:web": "npm run dev -w @cdp/web",
    "dev:sentinel": "npm run dev -w @cdp/sentinel",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "db:generate": "npm run generate -w @cdp/db",
    "db:migrate": "npm run migrate -w @cdp/db",
    "db:seed": "npm run seed -w @cdp/db",
    "sim": "npm run start -w @cdp/sim-terminals --"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.54.0",
    "@types/node": "^22.15.0",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vitest": "^4.1.12"
  },
  "prisma": {
    "schema": "db/prisma/schema.prisma"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
