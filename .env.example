# Copia este archivo a .env (raíz) y a backend/api/.env (y db/.env para el seed). Nunca subas el .env real.

# --- API ---
DATABASE_URL=postgresql://cdp_app:cambia-esto@127.0.0.1:5432/cdp
HOST=127.0.0.1
PORT=3000
JWT_SECRET=genera-uno-con-openssl-rand-hex-32
# Pimienta para HMAC de identificadores (email, teléfono). Si cambia, se pierden los matches.
IDENTITY_PEPPER=genera-otro-valor-aleatorio
# Subred ZeroTier autorizada (la ves en my.zerotier.com > Networks > Managed Routes)
ZT_SUBNET=10.147.20.0/24
# true solo si Apache termina TLS
COOKIE_SECURE=false

# --- Seed de usuarios iniciales (contraseñas mínimo 12 caracteres) ---
SEED_USUARIO_EMAIL=usuario@fkps.local
SEED_USUARIO_PASSWORD=
SEED_ADMIN_EMAIL=admin@fkps.local
SEED_ADMIN_PASSWORD=
SEED_SUPER_EMAIL=super@fkps.local
SEED_SUPER_PASSWORD=
SEED_QA_EMAIL=qa@fkps.local
SEED_QA_PASSWORD=
# Llave de la fuente "simulador" (la usa backend/simulator)
SIM_SOURCE_KEY=

# --- Sentinel ---
SENTINEL_TOKEN=
APACHE_LOG_DIR=C:/Apache24/logs
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
CDP_API_URL=http://127.0.0.1:3000
