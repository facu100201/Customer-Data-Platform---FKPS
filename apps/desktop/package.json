{
  "name": "@cdp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Terminal ligera (thin client) del CDP FKPS",
  "author": "Equipo FKPS",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "mx.edu.usb.fkps.cdp",
    "productName": "CDP FKPS Terminal",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "terminal.config.example.json",
        "to": "terminal.config.example.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
